# 거래 환경: mock(모의) 또는 real(실전)
TRADING_ENV=mock

# 전략 폴더 위치 (생략하면 backend/strategies)
# STRATEGIES_DIR=strategies

# 실행 기록 폴더 위치 (생략하면 backend/runs)
# RUNS_DIR=runs

# NH선물 API 인증 정보. TRADING_ENV가 고른 환경(모의 또는 실전)의 키를 넣는다.
# NH_APP_KEY=
# NH_APP_SECRET=

# 백테스트 비용 가정 (생략하면 수수료 0.0085%, 슬리피지 1틱)
# BACKTEST_FEE_RATE=0.000085
# BACKTEST_SLIPPAGE_TICKS=1
